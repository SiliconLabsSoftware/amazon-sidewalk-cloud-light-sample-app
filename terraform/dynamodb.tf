locals {
  dynamodb_table = "CloudLight"
}

resource "aws_dynamodb_table" "table" {
  name         = local.dynamodb_table
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "PK"
  range_key    = "SK"

  attribute {
    name = "PK"
    type = "S"
  }

  attribute {
    name = "SK"
    type = "S"
  }

  ttl {
    attribute_name = "expires"
    enabled        = true
  }
}
