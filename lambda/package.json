{
  "name": "lambda",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "esbuild src/handlers/*.ts --bundle --platform=node --target=node24 --format=esm --main-fields=module,main --outdir=dist --out-extension:.js=.mjs",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.7.1",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.940.0"
  }
}
