{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "BackendBucket",
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket",
                "s3:ListBucket",
                "s3:GetBucketVersioning",
                "s3:PutBucketVersioning"
            ],
            "Resource": [
                "arn:aws:s3:::cloud-light-terraform-backend-*"
            ]
        },
        {
            "Sid": "BackendState",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject",
                "s3:GetObjectVersion",
                "s3:DeleteObjectVersion"
            ],
            "Resource": "arn:aws:s3:::cloud-light-terraform-backend-*/*"
        }
    ]
}